# ngrok authtoken from https://dashboard.ngrok.com. Register it once with:  ngrok config add-authtoken <token>
NGROK_PHASE_1_TOKEN=.....

# Optional shared secret. If set BEFORE starting the server, every /phase1/* request must send `X-API-Key: <value>`.
# Empty = no authentication (anyone with the ngrok URL can call the API).
PHASE1_API_KEY=.....

# Optional overrides (defaults shown)
# PHASE1_MODEL_DIR=models/phase1/task_adapted
# PHASE1_CONFIG=configs/phase1.yaml
# PHASE1_STEAM_API=1            # 0 = never call the Steam Store API for app_ids missing from game_context.parquet
# PHASE1_MIN_SCORE=             # default score cut of /phase1/filter, 0..1. Empty = the model threshold (0.41); 0 = drop no review by score

# --- Phase 3 CLI (the caller of the Phase 1 API) --------------------------------------------------------------------
# Public URL printed by `ngrok http 8000`, no trailing slash
PHASE_1_BASE_ENDPOINT=https://<your-static-domain>.ngrok-free.dev
